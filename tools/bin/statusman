#!/usr/bin/env bash

set -u

TOOL=${0##*/}
TOOL=${TOOL%.exe}

case "$TOOL" in
    statusman|mrproper|ironman|doorman) ;;
    *)
        printf 'CODELAXY ERROR: unknown launcher name: %s\n' "$TOOL" >&2
        exit 1
        ;;
esac

if ! command -v git >/dev/null 2>&1
then
    printf 'CODELAXY ERROR: Git was not found in PATH.\n' >&2
    exit 1
fi

ROOT_DIR=$(git rev-parse --show-toplevel 2>/dev/null || true)

if [ -z "$ROOT_DIR" ]
then
    printf 'CODELAXY ERROR: not inside a Git worktree.\n' >&2
    exit 1
fi

if command -v cygpath >/dev/null 2>&1
then
    ROOT_DIR=$(cygpath -u "$ROOT_DIR") || exit 1
fi

TARGET="$ROOT_DIR/tools/$TOOL.sh"

if [ ! -f "$TARGET" ]
then
    printf 'CODELAXY ERROR: %s does not provide tools/%s.sh.\n' \
        "$ROOT_DIR" "$TOOL" >&2
    exit 1
fi

exec bash "$TARGET" "$@"
