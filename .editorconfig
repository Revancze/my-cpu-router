root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,c}]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{json,md,py,sh}]
end_of_line = lf

[.gitattributes]
end_of_line = lf

[githooks/*]
end_of_line = lf

[*.{cmd,bat}]
end_of_line = crlf
