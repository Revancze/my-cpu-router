#!/bin/sh

set -u

echo
echo "========================================"
echo " CPU Router - pre-commit checks"
echo "========================================"
echo

ROOT_DIR=$(git rev-parse --show-toplevel 2>/dev/null)

if [ -z "$ROOT_DIR" ]
then
    echo "PRE-COMMIT FAILED"
    echo "Could not find Git repository root."
    exit 1
fi

cd "$ROOT_DIR" || exit 1

echo "[1/3] Checking staged whitespace..."

if ! git diff --cached --check
then
    echo
    echo "PRE-COMMIT FAILED"
    echo "Staged files contain whitespace errors."
    echo
    exit 1
fi

echo "PASS"
echo

echo "[2/3] Checking final newline..."

failed=0
file_list=$(mktemp)

if [ -z "$file_list" ] || [ ! -f "$file_list" ]
then
    echo
    echo "PRE-COMMIT FAILED"
    echo "Could not create temporary file list."
    echo
    exit 1
fi

git diff --cached \
    --name-only \
    --diff-filter=ACMR > "$file_list"

while IFS= read -r file
do
    case "$file" in
        *.cpp|*.hpp|*.h|*.c|*.json|*.md|*.py|*.sh|*.cmd|*.bat|.editorconfig|.gitattributes|githooks/*)
            if ! git cat-file -e ":$file" 2>/dev/null
            then
                continue
            fi

            file_size=$(git cat-file -s ":$file" 2>/dev/null)

            if [ "$file_size" -eq 0 ]
            then
                echo "FAIL: $file is empty and has no final newline."
                failed=1
                continue
            fi

            last_byte=$(
                git show ":$file" |
                tail -c 1 |
                od -An -t x1 |
                tr -d ' \n'
            )

            if [ "$last_byte" != "0a" ]
            then
                echo "FAIL: $file has no final newline."
                failed=1
            fi
            ;;
    esac
done < "$file_list"

rm -f "$file_list"

if [ "$failed" -ne 0 ]
then
    echo
    echo "PRE-COMMIT FAILED"
    echo "One or more staged files have no final newline."
    echo
    exit 1
fi

echo "PASS"
echo

echo "[3/3] Building and running tests from staged snapshot..."

snapshot_dir=$(mktemp -d)

if [ -z "$snapshot_dir" ] || [ ! -d "$snapshot_dir" ]
then
    echo
    echo "PRE-COMMIT FAILED"
    echo "Could not create staged snapshot directory."
    echo
    exit 1
fi

cleanup_snapshot()
{
    rm -rf "$snapshot_dir"
}

trap cleanup_snapshot 0

if ! git checkout-index \
    --all \
    --force \
    --prefix="$snapshot_dir/"
then
    echo
    echo "PRE-COMMIT FAILED"
    echo "Could not create staged snapshot."
    echo
    exit 1
fi

if [ ! -f "$snapshot_dir/tools/verify.sh" ]
then
    echo
    echo "PRE-COMMIT FAILED"
    echo "Staged snapshot does not contain tools/verify.sh."
    echo
    exit 1
fi

if ! sh "$snapshot_dir/tools/verify.sh"
then
    echo
    echo "PRE-COMMIT FAILED"
    echo "Build or tests failed in staged snapshot."
    echo
    exit 1
fi

echo "PASS"
echo

echo "========================================"
echo " PRE-COMMIT CHECKS PASSED"
echo "========================================"
echo

exit 0
